# Copy to .env (gitignored). In Cloud Run, secrets come from Secret Manager.
OPENAI_API_KEY=
# Model IDs live ONLY here (verified against /v1/models on 2026-10-20). Team choice: the small tier for cost.
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_SMART_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
# Vertex fallback/judge (P1, phase 8c). Never a gemini-2.5-* ID.
VERTEX_MODEL=
GCP_PROJECT=mda-atomcamp
GCP_REGION=us-central1
# Optional: Google Chat incoming webhook (absent → UI "Chat card" panel fallback)
CHAT_WEBHOOK_URL=
# Operator token for mutating API routes (held server-side by sentinel-web)
OPERATOR_TOKEN=
SENTINEL_API_URL=http://localhost:8080
SIM_BASE_URL=http://localhost:8081

# Copy to .env (gitignored). Never commit secrets. See CLAUDE.md for the rules.

# --- LLM -------------------------------------------------------------------
# The SDK reads OPENAI_API_KEY (the old OPEN_AI_KEY name is retired).
OPENAI_API_KEY=
# Model IDs live only here; set from docs/research/model-ids.md. Never gemini-2.5-*.
OPENAI_FAST_MODEL=
OPENAI_SMART_MODEL=
OPENAI_EMBED_MODEL=
# openai | vertex | scripted (test-only, shows a UI badge) | fake (unit tests only)
LLM_PROVIDER=scripted
# Vertex Gemini (P1). Set from docs/research/model-ids.md.
VERTEX_MODEL=
VERTEX_LOCATION=

# --- GCP -------------------------------------------------------------------
GCP_PROJECT=
GCP_REGION=asia-south1

# --- Infrastructure --------------------------------------------------------
# memory | pubsub
BUS=memory
# memory | bigquery
STORE=memory
# Google Chat incoming webhook; empty = cards are stored and shown in the UI only.
CHAT_WEBHOOK_URL=

# --- Policy and demo -------------------------------------------------------
# shadow | enforce
SECURITY_AUTONOMY=shadow
KILL_SWITCH=0
# Enables /demo/* routes. On Cloud Run they also need X-Demo-Passcode.
DEMO_CONTROLS=1
DEMO_PASSCODE=

# --- Simulator -------------------------------------------------------------
SIM_BASE_URL=http://localhost:8081
SIM_ADMIN_TOKEN=dev-admin-token
# Simulated-time multiplier (10 = a 60 s recovery takes ~6 s of wall time).
SIM_SPEED=1
# http | pubsub
EMIT_MODE=http

# --- Wiring and tests ------------------------------------------------------
# sentinel-web proxies the browser to this (D2). Compose overrides it.
API_INTERNAL_URL=http://localhost:8080
# Evidence folder the current phase writes, e.g. phase-00-foundation.
EVIDENCE_PHASE=phase-00-foundation
# Hard cap for live evaluation runs.
EVAL_MAX_USD=5
# 1 on Cloud Run; the Pub/Sub emulator sends no OIDC token.
PUBSUB_VERIFY_OIDC=0
